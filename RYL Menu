local function refreshESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hasHighlight = p.Character:FindFirstChild("MenuESP")
            if _G.FPS_Settings.ESP then
                local isTeammate = p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team
                local targetColor = isTeammate and Color3.fromRGB(0, 240, 255) or Color3.fromRGB(255, 30, 30)
                if not hasHighlight then
                    local highlight = Instance.new("Highlight") ; highlight.Name = "MenuESP" ; highlight.FillColor = targetColor ; highlight.OutlineColor = Color3.fromRGB(255, 255, 255) ; highlight.FillTransparency = 0.4 ; highlight.Parent = p.Character
                else
                    hasHighlight.FillColor = targetColor
                end
            else
                if hasHighlight then hasHighlight:Destroy() end
            end
        end
    end
end

createToggleElement("FPS", "ESP", "ESP", function(enabled)
    if _G.ESPConnection then _G.ESPConnection:Disconnect() end ; refreshESP()
    if enabled then _G.ESPConnection = RunService.Heartbeat:Connect(refreshESP) end
end)

