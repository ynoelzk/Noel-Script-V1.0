    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = targetPage
    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(0, 6)
    bCorner.Parent = btn
    local bStroke = Instance.new("UIStroke")
    bStroke.Color = Color3.fromRGB(40, 40, 40)
    bStroke.Parent = btn
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 12, 1, -16)
    indicator.Position = UDim2.new(1, -22, 0, 8)
    indicator.Parent = btn
    local iCorner = Instance.new("UICorner")
    iCorner.CornerRadius = UDim.new(1, 0)
    iCorner.Parent = indicator

    local function updateVisual()
        if _G.FPS_Settings[configKey] then
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            indicator.BackgroundColor3 = Color3.fromRGB(0, 220, 100)
            btn.Text = "  [ ON ]  " .. text
        else
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            indicator.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            btn.Text = "  [ OFF ]  " .. text
        end
    end
