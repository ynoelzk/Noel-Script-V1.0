createToggleElement("Zaralho", "AntiGrab", "Anti Arrest (Weld Breaker)", function(enabled)
    if _G.AntiGrabConnection then _G.AntiGrabConnection:Disconnect() end
    if enabled then
        _G.AntiGrabConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if char and hum then
                local foiAgarrado = false
                
                -- Verifica todas as partes do personagem procurando conexões externas
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("Weld") or obj:IsA("WeldConstraint") or obj:IsA("ManualWeld") then
                        if obj.Part0 and obj.Part1 then
                            -- Se a Part0 ou Part1 não for nossa, é alguém nos segurando/algemando
                            if not obj.Part0:IsDescendantOf(char) or not obj.Part1:IsDescendantOf(char) then
                                obj:Destroy()
                                foiAgarrado = true
                            end
                        end
                    end
                end
                
                -- Se quebramos o agarrão, restaura a mobilidade caso o policial tenha dado stun
                if foiAgarrado then
                    hum.PlatformStand = false
                    hum.Sit = false
                    
                    -- Previne que o script deles deixe sua velocidade no 0
                    if hum.WalkSpeed < 16 then
                        hum.WalkSpeed = _G.FPS_Settings.SpeedValue or 16
                    end
                end
            end
        end)
    end
end)

