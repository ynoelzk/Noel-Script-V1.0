createToggleElement("FPS", "Aimbot", "Aimbot", function(enabled)
    if _G.AimbotConnection then _G.AimbotConnection:Disconnect() end
    if enabled then
        local moveMouse = mousemoverel or (Input and Input.MoveMouseTo)
