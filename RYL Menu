local originalProps = {}
createToggleElement("Zaralho", "Fling", "Fling Profissional (FE Dense Spin)", function(enabled)
    if _G.FlingConnection then _G.FlingConnection:Disconnect() end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if enabled and hrp then
        -- Salva as propriedades físicas originais
        if not originalProps[hrp] then originalProps[hrp] = hrp.CustomPhysicalProperties end
        
        -- Aplica peso máximo e remove fricção
        hrp.CustomPhysicalProperties = PhysicalProperties.new(100, 0, 0, 0, 0)
        
        local bav = Instance.new("BodyAngularVelocity")
        bav.Name = "ProfFling"
        bav.MaxTorque = Vector3.new(0, math.huge, 0) -- Força o giro apenas no eixo Y (estabilidade)
        bav.AngularVelocity = Vector3.new(0, 99999, 0) 
        bav.Parent = hrp

        _G.FlingConnection = RunService.Heartbeat:Connect(function()
            local currentChar = LocalPlayer.Character
            local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
            if currentHrp then
                -- Clampa a velocidade Y pra VOCÊ não voar, absorvendo impacto
                local vel = currentHrp.AssemblyLinearVelocity
                currentHrp.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
                
                -- Impede tropeços nos próprios membros ao girar
                for _, part in ipairs(currentChar:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if hrp then
            local bav = hrp:FindFirstChild("ProfFling")
            if bav then bav:Destroy() end
            
            -- Restaura as propriedades normais
            if originalProps[hrp] then hrp.CustomPhysicalProperties = originalProps[hrp] end
            
            if LocalPlayer.Character then
                for _, part in ipairs(LocalPlayer.Character:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end
    end
end)

