-- LÓGICAS DOS CHEATS (INALTERADAS DA ABA FPS E ND)
-- ========================================================================

local function isTargetVisible(targetCharacter, headPosition)
    local charParts = LocalPlayer.Character or workspace
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {charParts, targetCharacter, Camera}
    raycastParams.IgnoreWater = true
    local raycastResult = workspace:Raycast(Camera.CFrame.Position, headPosition - Camera.CFrame.Position, raycastParams)
    return raycastResult == nil
end

local function getClosestVisibleEnemy()
    local closestTarget = nil
    local shortestDistance = _G.FPS_Settings.Aimbot_FOV_Radius
    local mousePos = UserInputService:GetMouseLocation()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Head") then return nil end
    local localHeadPos = LocalPlayer.Character.Head.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and (not p.Team or p.Team ~= LocalPlayer.Team) and p.Character and p.Character:FindFirstChild("Head") then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local head = p.Character.Head
                local distanceInStuds = (localHeadPos - head.Position).Magnitude
                if distanceInStuds <= _G.FPS_Settings.Aimbot_Max_Distance then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local distanceToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if distanceToMouse < shortestDistance and isTargetVisible(p.Character, head.Position) then
                            shortestDistance = distanceToMouse
                            closestTarget = head
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

